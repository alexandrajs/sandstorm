{
  "name": "sandstorm",
  "version": "0.3.22",
  "description": "Not a MongoDB ORM",
  "main": "./index.js",
  "scripts": {
    "test": "nyc --reporter=lcov --reporter=html mocha -r ts-node/register test/**/*.ts && cat ./coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js && rm -rf ./coverage",
    "raw-test": "mocha -r ts-node/register test/**/*.ts",
    "docs": "typedoc --out docs src --entryPointStrategy expand ./src",
    "codeclimate": "docker run --rm --env CODECLIMATE_CODE=\"$PWD\" --volume \"$PWD\":/code --volume /var/run/docker.sock:/var/run/docker.sock --volume /tmp/cc:/tmp/cc codeclimate/codeclimate analyze -f html > codeclimate.html",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrajs/sandstorm"
  },
  "keywords": [
    "mongodb",
    "nodejs",
    "orm"
  ],
  "engines": {
    "node": ">=10.0.0"
  },
  "author": "ponury.kostek@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexandrajs/sandstorm/issues"
  },
  "homepage": "https://github.com/alexandrajs/sandstorm#readme",
  "peerDependencies": {
    "mongodb": "^6.16.0"
  },
  "dependencies": {
    "amule": "^0.2.5",
    "amule-aim": "^0.5.4",
    "amule-more": "^0.2.2",
    "amule-rush": "^0.3.6",
    "exterror": "^1.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.21",
    "benchmark": "^2.1.4",
    "coveralls": "^3.0.9",
    "mocha": "^7.0.0",
    "mocha-lcov-reporter": "^1.3.0",
    "mongodb": "^6.16.0",
    "nyc": "^15.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.4",
    "typescript": "^5.8.3"
  }
}
